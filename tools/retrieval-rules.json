        "credential setup",
        "authentication",
        "credentials"
      ],
      "match_source": "identifier"
    },
    {
      "pattern": "\\btimeout",
      "aliases": [
        "operation timeout",
        "duration"
      ]
    },
    {
      "pattern": "\\bimport\\b",
      "aliases": [
        "import existing resource",
        "adopt existing object"
      ]
    },
    {
      "pattern": "bot defense advanced protection",
      "aliases": [
        "advanced bot defense",
        "bot defense advanced protection"
      ]
    },
    {
      "pattern": "\\bhttps auto cert\\b",
      "match_source": "identifier",
      "aliases": [
        "automatic certificates",
        "automatic certificate management",
        "managed TLS certificates"
      ]
    },
    {
      "pattern": "\\b(?:success conditions|transaction result success|login result)\\b",
      "context_pattern": "\\blogin\\b|\\btransaction result\\b",
      "aliases": [
        "login success"
      ],
      "match_source": "schema_path"
    }
