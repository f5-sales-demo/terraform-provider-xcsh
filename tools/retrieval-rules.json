      ]
    },
    {
      "pattern": "\\b(?:success conditions|transaction result success|login result)$",
      "context_pattern": "\\blogin\\b|\\btransaction result\\b",
      "aliases": [
        "login success"
      ],
      "match_source": "schema_path"
    },
    {
      "pattern": "^timeouts(?: (?:create|read|update|delete))?$",
